{
  "name": "forest-procedural-god-game",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D largely-spectator procedural god game set in a photorealistic woodland civilization of anthropomorphic creatures.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.0.8"
  }
}
